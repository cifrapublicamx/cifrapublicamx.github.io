# Cifra Pública | Folio 003 | Paso 2: llenar la serie desde 2019.
# Se corre a mano una vez, después del sondeo y de confirmar las claves en data/fuentes/empleo/claves.json.
# Un job por año (dos a la vez, para no saturar al IMSS); al final un solo PR con todo.
name: "Empleo IMSS | 2. llenado inicial"

on:
  workflow_dispatch:
    inputs:
      desde:
        description: "Primer mes (AAAA-MM)"
        required: true
        default: "2019-01"
      hasta:
        description: "Último mes (AAAA-MM). Vacío = el más reciente."
        required: false
        default: ""

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: empleo-imss
  cancel-in-progress: false

jobs:
  plan:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      anios: ${{ steps.plan.outputs.anios }}
      total: ${{ steps.plan.outputs.total }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: scripts/empleo/requirements.txt
      - run: pip install -r scripts/empleo/requirements.txt
      - name: Meses pendientes
        id: plan
        env:
          DESDE: ${{ inputs.desde }}
          HASTA: ${{ inputs.hasta }}
        run: python scripts/empleo/extraer.py --plan --desde "$DESDE" --hasta "$HASTA"

  extraer:
    needs: plan
    if: needs.plan.outputs.total != '0'
    runs-on: ubuntu-latest
    timeout-minutes: 340
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix:
        anio: ${{ fromJSON(needs.plan.outputs.anios) }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: scripts/empleo/requirements.txt
      - run: pip install -r scripts/empleo/requirements.txt
      - name: Extraer ${{ matrix.anio }}
        continue-on-error: true
        env:
          DESDE: ${{ inputs.desde }}
          HASTA: ${{ inputs.hasta }}
          ANIO: ${{ matrix.anio }}
        run: |
          d="$ANIO-01"; if [[ "$DESDE" > "$d" ]]; then d="$DESDE"; fi
          h="$ANIO-12"; if [ -n "$HASTA" ] && [[ "$HASTA" < "$h" ]]; then h="$HASTA"; fi
          python scripts/empleo/extraer.py --faltantes --desde "$d" --hasta "$h" --max 12 --borrar-crudo
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: empleo-${{ matrix.anio }}
          path: data/processed/empleo/mensual/${{ matrix.anio }}-*
          if-no-files-found: warn
          retention-days: 7

  consolidar:
    needs: [plan, extraer]
    if: always() && needs.plan.outputs.total != '0'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: scripts/empleo/requirements.txt
      - run: pip install -r scripts/empleo/requirements.txt
      - uses: actions/download-artifact@v4
        with:
          pattern: empleo-*
          path: data/processed/empleo/mensual
          merge-multiple: true
      - name: Consolidar y revisar
        run: python scripts/empleo/consolidar.py
      - name: Abrir PR
        env:
          GH_TOKEN: ${{ github.token }}
          BASE_REF: ${{ github.event.repository.default_branch }}
          RAMA: empleo/llenado-${{ github.run_id }}
          DESDE: ${{ inputs.desde }}
        run: |
          bash scripts/empleo/abrir_pr.sh "$RAMA" "Empleo IMSS: llenado desde $DESDE" \
            data/processed/empleo/control.md data/processed/empleo
